# Nota: este .gitignore está en una subcarpeta; para que afecte todo el repositorio muévelo a la raíz:
# d:\Escritorio\Carpetas con cosas\Programas\.gitignore

# Ignorar caches y artefactos
__pycache__/
*.pyc
*.log
*.txt
# Ignorar credenciales y salidas
.spotify_cache/
spotify_credentials.json
output.txt
error_output.txt

# VSCode local settings
.vscode/settings.json

# Otros archivos grandes o locales
*.db
*.sqlite

# Añadidos: carpetas y archivos que no quieres versionar
.cache/
.idea/
.vscode/
AxolutlyMobile/
HTML/
Java/
Lua/
Python/
Quitar\ Fondo/
bot.log
build/
config/
config_paths.json
data/
download_history.txt
extractores_yt-dlp.txt
ffmpeg-7.1-full_build/
flutter/
realesrgan-ncnn-vulkan.rar
spotify_downloader.log
u2net.onnx