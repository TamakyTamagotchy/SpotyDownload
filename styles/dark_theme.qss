/* 
 * Spotify Downloader - Modern Dark Theme
 * Diseño profesional con transiciones suaves
 */

/* ==================== BASE ==================== */
QMainWindow, QDialog {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #0F0F0F, stop:1 #1A1A1A);
    color: #E0E0E0;
    border: 1px solid #2A2A2A;
}

QWidget {
    color: #E0E0E0;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    font-size: 13px;
    background-color: transparent;
}

/* ==================== NAVEGACIÓN LATERAL ==================== */
QWidget[class="SideNavigation"] {
    background-color: #1A1A1A;
    border-right: 1px solid #2A2A2A;
    border-radius: 0;
}

QWidget[class="SideNavigation"] QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    color: #B0B0B0;
    margin: 2px 8px;
}

QWidget[class="SideNavigation"] QPushButton:hover {
    background-color: #2A2A2A;
    color: #FFFFFF;
}

QWidget[class="SideNavigation"] QPushButton:checked {
    background-color: #1DB954;
    color: #FFFFFF;
    font-weight: 600;
}

/* ==================== BARRA SUPERIOR ==================== */
QWidget[class="TopBar"] {
    background-color: #1E1E1E;
    border-bottom: 1px solid #2A2A2A;
    padding: 8px 16px;
}

QWidget[class="TopBar"] QLabel {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 600;
}

QWidget[class="TopBar"] QPushButton {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 6px 12px;
    color: #E0E0E0;
    font-size: 12px;
}

QWidget[class="TopBar"] QPushButton:hover {
    background-color: #3A3A3A;
    border-color: #4A4A4A;
}

/* ==================== TABLAS ==================== */
QTableWidget {
    background-color: #1A1A1A;
    alternate-background-color: #1E1E1E;
    gridline-color: #2A2A2A;
    border-radius: 12px;
    border: 1px solid #2A2A2A;
    selection-background-color: #1DB954;
    selection-color: #FFFFFF;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #2A2A2A;
}

QTableWidget::item:selected {
    background-color: #1DB954;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #2A2A2A;
    color: #E0E0E0;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #3A3A3A;
    font-weight: 600;
    font-size: 13px;
}

/* ==================== CONTENEDORES Y TARJETAS ==================== */
QGroupBox {
    font-size: 16px;
    font-weight: 600;
    color: #FFFFFF;
    border: 2px solid #2A2A2A;
    border-radius: 12px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 4px 8px;
    background-color: #1A1A1A;
    border-radius: 6px;
}

/* ==================== SCROLLBARS MEJORADOS ==================== */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #1A1A1A;
    width: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4A4A4A, stop:1 #3A3A3A);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5A5A5A, stop:1 #4A4A4A);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

/* ==================== LABELS ==================== */
QLabel {
    color: #E0E0E0;
    background-color: transparent;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
}

QLabel[class="title"] {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
}

QLabel[class="subtitle"] {
    color: #B0B0B0;
    font-size: 14px;
    font-weight: 400;
}

/* ==================== MENÚS Y LISTAS ==================== */
QListWidget {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    alternate-background-color: #1E1E1E;
    selection-background-color: #1DB954;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #2A2A2A;
}

QListWidget::item:selected {
    background-color: #1DB954;
    color: #FFFFFF;
}

/* ==================== COMBO BOX ==================== */
QComboBox {
    background-color: #2A2A2A;
    border: 2px solid #3A3A3A;
    border-radius: 8px;
    padding: 8px 12px;
    color: #E0E0E0;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #4A4A4A;
}

QComboBox:focus {
    border-color: #1DB954;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(down_arrow.png); /* Puedes agregar una imagen */
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    selection-background-color: #1DB954;
    selection-color: #FFFFFF;
}

/* ==================== INPUTS ==================== */
QLineEdit {
    background-color: #2A2A2A;
    border: 2px solid #3A3A3A;
    border-radius: 10px;
    padding: 12px 16px;
    color: #E0E0E0;
    font-size: 14px;
    min-height: 20px;
    selection-background-color: #1DB954;
}

QLineEdit:focus {
    border-color: #1DB954;
    background-color: #2F2F2F;
}

QLineEdit:hover {
    border-color: #4A4A4A;
}

/* ==================== BOTONES ==================== */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #1DB954, stop:1 #169C46);
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #1ED760, stop:1 #169C46);
}

QPushButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #169C46, stop:1 #0F7B3A);
}

QPushButton:disabled {
    background-color: #3A3A3A;
    color: #888888;
}

QPushButton:disabled {
    background-color: #3A3A3A;
    color: #666666;
}

QPushButton#secondaryButton {
    background-color: #3A3A3A;
    color: #E0E0E0;
    border: 1px solid #4A4A4A;
}

QPushButton#secondaryButton:hover {
    background-color: #4A4A4A;
}

QPushButton#dangerButton {
    background-color: #E53935;
}

QPushButton#dangerButton:hover {
    background-color: #EF5350;
}

QPushButton#ghostButton {
    background-color: transparent;
    color: #1DB954;
    border: 1px solid #1DB954;
}

QPushButton#ghostButton:hover {
    background-color: rgba(29, 185, 84, 0.1);
}

/* ==================== COMBOBOX ==================== */
QComboBox {
    background-color: #2A2A2A;
    border: 2px solid #3A3A3A;
    border-radius: 8px;
    padding: 10px 16px;
    color: #E0E0E0;
    min-height: 20px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #4A4A4A;
}

QComboBox:focus {
    border-color: #1DB954;
}

QComboBox::drop-down {
    border: none;
    padding-right: 16px;
}

QComboBox QAbstractItemView {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    selection-background-color: #1DB954;
    padding: 4px;
}

/* ==================== CHECKBOX ==================== */
QCheckBox {
    spacing: 10px;
    color: #E0E0E0;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 2px solid #3A3A3A;
    background-color: #2A2A2A;
}

QCheckBox::indicator:hover {
    border-color: #4A4A4A;
}

QCheckBox::indicator:checked {
    background-color: #1DB954;
    border-color: #1DB954;
}

/* ==================== PROGRESS BAR ==================== */
QProgressBar {
    background-color: #2A2A2A;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #1DB954;
    border-radius: 4px;
}

/* ==================== LABELS ==================== */
QLabel {
    background: transparent;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#subtitleLabel {
    font-size: 14px;
    color: #888888;
}

QLabel#accentLabel {
    color: #1DB954;
    font-weight: bold;
}

/* ==================== GROUP BOX ==================== */
QGroupBox {
    font-weight: bold;
    border: 1px solid #3A3A3A;
    border-radius: 12px;
    margin-top: 16px;
    padding: 16px;
    background-color: #1A1A1A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #1DB954;
}

/* ==================== TAB WIDGET ==================== */
QTabWidget::pane {
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    background-color: #1A1A1A;
}

QTabBar::tab {
    background-color: #2A2A2A;
    color: #888888;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #1A1A1A;
    color: #1DB954;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #3A3A3A;
}

/* ==================== TABLE ==================== */
QTableWidget {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    gridline-color: #2A2A2A;
}

QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #2A2A2A;
}

QTableWidget::item:selected {
    background-color: rgba(29, 185, 84, 0.2);
    color: #FFFFFF;
}

QTableWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QHeaderView::section {
    background-color: #2A2A2A;
    color: #888888;
    padding: 10px;
    border: none;
    font-weight: bold;
}

/* ==================== LIST WIDGET ==================== */
QListWidget {
    background-color: #1A1A1A;
    border: none;
    border-radius: 8px;
    padding: 4px;
}

QListWidget::item {
    padding: 12px 16px;
    border-radius: 8px;
    margin: 2px 0;
}

QListWidget::item:selected {
    background-color: rgba(29, 185, 84, 0.15);
    color: #1DB954;
}

QListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.05);
}

/* ==================== MENU ==================== */
QMenu {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1DB954;
    color: #FFFFFF;
}

/* ==================== TOOLTIP ==================== */
QToolTip {
    background-color: #2A2A2A;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 6px 10px;
}

/* ==================== SLIDER ==================== */
QSlider::groove:horizontal {
    background-color: #3A3A3A;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #1DB954;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #1ED760;
}

QSlider::sub-page:horizontal {
    background-color: #1DB954;
    border-radius: 3px;
}

/* ==================== MESSAGE BOX ==================== */
QMessageBox {
    background-color: #1E1E1E;
}

QMessageBox QLabel {
    color: #E0E0E0;
}

/* ==================== CARDS ==================== */
QFrame#card {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 12px;
}

QFrame#card:hover {
    border-color: #3A3A3A;
}
